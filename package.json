{
  "name": "awwv",
  "version": "0.1.0",
  "description": "A War Without Victory (AWWV) simulation prototype",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "tsx --test \"tests/**/*.ts\"",
    "dev": "tsx watch --test \"tests/**/*.ts\"",
    "sim:run": "tsx src/cli/sim_run.ts",
    "sim:scenario": "tsx src/cli/sim_scenario.ts",
    "sim:validate": "tsx src/cli/sim_validate.ts",
    "sim:smoke": "tsx src/cli/sim_smoke.ts",
    "sim:aorcheck": "tsx src/cli/sim_aorcheck.ts",
    "sim:mapcheck": "tsx src/cli/sim_mapcheck.ts",
    "sim:frontedges": "tsx src/cli/sim_front_edges.ts",
    "sim:frontregions": "tsx src/cli/sim_front_regions.ts",
    "sim:frontstate": "tsx src/cli/sim_front_state.ts",
    "sim:setposture": "tsx src/cli/sim_set_posture.ts",
    "sim:setpostureregion": "tsx src/cli/sim_set_posture_region.ts",
    "sim:frontbreaches": "tsx src/cli/sim_front_breaches.ts",
    "sim:proposeflips": "tsx src/cli/sim_propose_flips.ts",
    "sim:supply": "tsx src/cli/sim_supply.ts",
    "sim:phase5check": "tsx src/cli/sim_phase5_check.ts",
    "sim:formations": "tsx src/cli/sim_formations.ts",
    "sim:militia": "tsx src/cli/sim_militia.ts",
    "sim:displacement": "tsx src/cli/sim_displacement.ts",
    "sim:sustainability": "tsx src/cli/sim_sustainability.ts",
    "sim:genformations": "tsx src/cli/sim_generate_formations.ts",
    "sim:commitment": "tsx src/cli/sim_commitment_report.ts",
    "sim:ops": "tsx src/cli/sim_ops_report.ts",
    "sim:negotiation": "tsx src/cli/sim_negotiation.ts",
    "sim:negotiate": "tsx src/cli/sim_negotiate.ts",
    "sim:negcap": "tsx src/cli/sim_negcap.ts",
    "sim:treaty": "tsx src/cli/sim_treaty.ts",
    "sim:valuation": "tsx src/cli/sim_valuation.ts",
    "sim:endstate": "tsx src/cli/sim_endstate.ts",
    "sim:competences": "tsx src/cli/sim_competences.ts",
    "sim:phase3a:ab": "tsx src/cli/phase3a_ab_harness.ts",
    "phase3:abc_audit": "tsx src/cli/phase3abc_audit_harness.ts",
    "phase3:abc_audit:tsx": "tsx src/cli/phase3abc_audit_harness.ts",
    "dev:map": "vite --config dev_ui/vite.config.ts",
    "dev:runner": "tsx tools/dev_runner/server.ts",
    "map:audit": "tsx tools/map_build/audit_map.ts",
    "map:build": "tsx tools/map_build/build_map.ts",
    "map:build:new": "tsx tools/map/build_map.ts",
    "build:map": "tsx tools/map/build_map_pipeline.ts",
    "map:check": "tsx tools/map/check_map.ts",
    "map:view-munis": "tsx tools/map/build_municipality_viewer_html.ts",
    "map:view": "node tools/map/serve_viewer.js",
    "map:fix:ids": "tsx tools/map/fix_duplicate_settlement_ids.ts",
    "map:adj": "python tools/map_build/adjacency.py",
    "map:print-failures": "tsx tools/map_build/print_polygon_failures.ts",
    "map:fixqueue": "tsx tools/map_build/fix_queue.ts",
    "map:applyhull": "tsx tools/map_build/apply_fallback_fixes.ts",
    "map:repair": "tsx scripts/map/repair_settlements_geom.ts",
    "map:validate": "tsx src/cli/mapkit_validate.ts",
    "map:regen": "tsx scripts/map/regenerate_settlements_geojson.ts",
    "map:regen:validate": "tsx src/cli/mapkit_validate.ts --input data/derived/settlements_polygons.regen.geojson",
    "map:diagnose": "tsx scripts/map/diagnose_settlement_regimes.ts",
    "map:normalize": "tsx scripts/map/normalize_coordinate_regimes.ts",
    "map:validate:norm": "tsx src/cli/mapkit_validate.ts --input data/derived/settlements_polygons.normalized.v1.geojson",
    "map:report:two-means": "tsx scripts/map/report_two_means_by_source.ts",
    "map:report:missing-edge-sids": "tsx scripts/map/report_missing_edge_sids.ts",
    "map:report:orphans": "tsx scripts/map/report_orphan_settlements.ts",
    "map:report:outside-muni": "tsx scripts/map/report_settlements_outside_municipality.ts",
    "map:fix:edges": "tsx scripts/map/fix_edges_canonicalize_sids.ts",
    "map:promote": "tsx scripts/map/promote_regen.ts",
    "map:view:prep": "node tools/map_viewer/prep.js",
    "map:view": "node tools/map_viewer/server.js",
    "map:view:simple:prep": "node tools/map_viewer_simple/prep.js",
    "map:view:simple": "node tools/map_viewer_simple/server.js",
    "map:all": "npm run map:audit && npm run map:build && npm run map:adj && npm run sim:mapcheck",
    "map:master:build": "tsx tools/map/build_master_census.ts",
    "map:master:check": "tsx tools/map/build_master_census.ts --dry-run",
    "map:master:audit": "npm run map:master:build && type data\\source\\master_census_audit.txt",
    "map:master:mismatch": "tsx tools/map/audit_aggregate_mismatch.ts",
    "map:svgs:join": "tsx tools/map/join_svgs_into_master.ts",
    "map:svgs:join:report": "npm run map:svgs:join && type data\\source\\svg_join_report.txt",
    "map:svgs:join:order": "tsx tools/map/join_svgs_by_order.ts",
    "map:svgs:join:order:report": "npm run map:svgs:join:order && type data\\source\\svg_join_order_report.txt",
    "map:coverage": "tsx tools/map/report_geometry_coverage.ts",
    "map:extract:muni:drzava": "tsx tools/map/extract_municipality_borders_from_drzava.ts",
    "map:reconstruct:muni": "tsx tools/map/reconstruct_municipalities_from_legacy.ts",
    "map:view:reconstructed": "tsx tools/map/build_municipality_reconstructed_viewer_html.ts",
    "map:derive:muni-from-fabric": "tsx tools/map/derive_municipality_outlines_from_fabric.ts",
    "map:derive:muni-boundaries-from-fabric": "tsx tools/map/derive_municipality_boundaries_from_fabric.ts",
    "map:view-geojson": "tsx tools/map/serve_geography_viewer.ts",
    "map:audit-munis": "tsx tools/map/audit_municipality_geometry.ts",
    "map:extract-muni-outlines": "tsx tools/map/extract_muni_outlines_from_html.ts",
    "map:view-muni-svg": "tsx tools/map/serve_svg_muni_viewer.ts",
    "map:view-fit": "tsx tools/map/serve_fit_viewer.ts",
    "map:clean-muni-outlines": "tsx tools/map/clean_muni_outlines_by_fabric.ts",
    "map:derive-muni-boundaries": "tsx tools/map/derive_municipality_boundaries_from_fabric.ts",
    "map:clean-muni-fabric": "tsx tools/map/clean_fabric_muni_boundaries_by_sampling.ts",
    "map:derive-muni-borders": "tsx tools/map/derive_municipality_borders_from_settlements.ts",
    "map:check-derive-muni-borders": "tsx tools/map/check_and_derive_muni_borders.ts",
    "map:view-map": "npm run map:check-derive-muni-borders && tsx tools/map/serve_simple_map_viewer.ts",
    "map:derive:substrate": "tsx scripts/map/derive_settlement_substrate_from_svg_sources.ts",
    "map:derive:graph": "tsx scripts/map/derive_settlement_graph_phase1_validate.ts",
    "map:audit:borderfabric": "tsx scripts/map/audit_canonical_border_fabric.ts",
    "map:derive:graph:v2": "tsx scripts/map/derive_settlement_graph_from_substrate_v2_overlap.ts",
    "map:derive:graph:v3": "tsx scripts/map/derive_settlement_graph_v3_robust.ts",
    "map:viewer:adjacency": "tsx scripts/map/build_adjacency_viewer.ts",
    "map:serve:adjacency": "tsx scripts/map/serve_adjacency_viewer.ts",
    "map:diagnose:nearmiss": "tsx scripts/map/diagnose_settlement_contiguity_nearmiss.ts",
    "map:diagnose:touchclass": "tsx scripts/map/diagnose_touch_pairs_point_vs_border.ts",
    "map:derive:contact": "tsx scripts/map/derive_settlement_contact_graph_pointtouch.ts",
    "map:viewer:substrate:index": "tsx scripts/map/build_substrate_viewer_index.ts",
    "map:rebuild:svg_substrate": "tsx scripts/map/rebuild_settlements_geojson_from_svg_js.ts",
    "map:viewer:svg_substrate:index": "tsx scripts/map/build_svg_substrate_viewer_index.ts",
    "map:audit:svg_substrate:coverage": "tsx scripts/map/audit_svg_substrate_coverage.ts",
    "map:derive:contact:phase1": "tsx scripts/map/derive_settlement_contact_graph_phase1.ts",
    "map:contact:enrich2": "tsx scripts/map/enrich_settlement_contact_graph_phase2.ts",
    "map:contact:report2_5": "tsx scripts/map/report_settlement_contact_graph_phase2_5.ts",
    "map:viewer:contact:phase1": "tsx scripts/map/build_contact_graph_viewer.ts",
    "audit:muni": "tsx tools/map/audit_municipality_coverage.ts",
    "audit:muni:diagnose-borders": "tsx tools/map/diagnose_border_ids.ts",
    "audit:settlements:muni": "tsx tools/map/audit_settlement_muni_alignment.ts",
    "assistant:mistakes": "cat docs/ASSISTANT_MISTAKES.log",
    "assistant:mistakes:open": "powershell -Command \"Get-Content docs/ASSISTANT_MISTAKES.log -Tail 80\"",
    "context": "tsx tools/assistant/print_context.ts",
    "repo:cleanup:audit": "tsx scripts/repo/cleanup_audit.ts",
    "docs:edit:phase3a": "tsx tools/docs/invoke_edit_docx.ts",
    "docs:validate:phase3a": "tsx tools/docs/validate_phase3a_docs_runner.ts"
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node",
    "preferTsExts": true,
    "experimentalResolver": true
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@turf/boolean-intersects": "^7.3.2",
    "@turf/boolean-valid": "^7.3.2",
    "@turf/turf": "^7.3.2",
    "svg-path-parser": "^1.1.0",
    "adm-zip": "^0.5.16",
    "xlsx": "^0.18.5",
    "concaveman": "^1.2.1",
    "polyclip-ts": "^0.16.8"
  }
}
